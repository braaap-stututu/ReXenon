+                if (!PPC_BL(w))
+                {
+                    why = "b";
+                    return true;
+                }
+                const size_t target = PPC_BA(w) ? size_t(uint32_t(PPC_BI(w))) : address + PPC_BI(w);
+                auto symbol = image.symbols.find(target);
