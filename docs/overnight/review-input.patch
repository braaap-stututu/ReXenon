diff --git a/ReXenonTests/CMakeLists.txt b/ReXenonTests/CMakeLists.txt
new file mode 100644
index 0000000..a3b307b
--- /dev/null
+++ b/ReXenonTests/CMakeLists.txt
@@ -0,0 +1,44 @@
+project("ReXenonTests")
+
+# Off unless asked for (ReXenonTests/run.py configures build-tests with it on), so other build
+# directories are unaffected.
+option(REXENON_TESTS "Build the ReXenon instruction test driver" OFF)
+if (NOT REXENON_TESTS)
+    return()
+endif()
+
+# LibXenonAnalyse's sources include fmt but the library doesn't link it (yet); harmless if it does.
+target_link_libraries(LibXenonAnalyse PUBLIC fmt::fmt)
+
+# The test driver: assembles Xenia's PPC instruction tests and recompiles them with the real
+# emitter (recompiler.cpp), writing C++ and test vectors that run.py compiles and runs.
+add_executable(ReXenonTestDriver
+    "driver.cpp"
+    "assembler.cpp"
+    "ppc_tables.c"
+    "${XENONRECOMP_ROOT}/recompiler.cpp"
+    "${XENONRECOMP_ROOT}/recompiler_config.cpp")
+
+target_include_directories(ReXenonTestDriver PRIVATE ${XENONRECOMP_ROOT} ${CMAKE_CURRENT_SOURCE_DIR})
+
+# recompiler_config.cpp relies on the precompiled header being force-included, as in XenonRecomp.
+target_precompile_headers(ReXenonTestDriver PRIVATE "${XENONRECOMP_ROOT}/pch.h")
+set_source_files_properties("ppc_tables.c" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
+
+target_link_libraries(ReXenonTestDriver PRIVATE
+    LibXenonAnalyse
+    XenonUtils
+    fmt::fmt
+    tomlplusplus::tomlplusplus
+    xxHash::xxhash)
+
+target_compile_features(ReXenonTestDriver PRIVATE cxx_std_20)
+target_compile_definitions(ReXenonTestDriver PRIVATE _CRT_SECURE_NO_WARNINGS NOMINMAX)
+
+if (CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+    target_compile_options(ReXenonTestDriver PRIVATE -Wno-switch -Wno-unused-variable -Wno-null-arithmetic)
+    # Same as XenonRecomp, so the generated code is what a port gets.
+    if (NOT APPLE)
+        target_compile_definitions(ReXenonTestDriver PRIVATE XENON_RECOMP_USE_ALIAS)
+    endif()
+endif()
diff --git a/ReXenonTests/assembler.cpp b/ReXenonTests/assembler.cpp
new file mode 100644
index 0000000..0462bac
--- /dev/null
+++ b/ReXenonTests/assembler.cpp
@@ -0,0 +1,513 @@
+#include "assembler.h"
+#include "ppc_tables.h"
+
+#include <dis-asm.h>
+#include <cctype>
+#include <cstring>
+
+namespace rxt
+{
+    std::string Trim(const std::string& s)
+    {
+        size_t b = 0, e = s.size();
+        while (b < e && std::isspace((unsigned char)s[b])) ++b;
+        while (e > b && std::isspace((unsigned char)s[e - 1])) --e;
+        return s.substr(b, e - b);
+    }
+
+    std::vector<std::string> SplitOperands(const std::string& text)
+    {
+        std::vector<std::string> out;
+        std::string t = Trim(text);
+        if (t.empty())
+            return out;
+        int depth = 0;
+        std::string cur;
+        for (char c : t)
+        {
+            if (c == '(') depth++;
+            if (c == ')') depth--;
+            if (c == ',' && depth == 0)
+            {
+                out.push_back(Trim(cur));
+                cur.clear();
+                continue;
+            }
+            cur += c;
+        }
+        out.push_back(Trim(cur));
+        return out;
+    }
+
+    namespace
+    {
+        struct Parser
+        {
+            const std::string& s;
+            size_t i = 0;
+            const LabelLookup& labels;
+            bool usedLabel = false;
+            int primaries = 0;
+            char lastRegClass = 0;
+            std::string error;
+
+            void Skip() { while (i < s.size() && std::isspace((unsigned char)s[i])) ++i; }
+
+            bool Expr(int64_t& v)
+            {
+                if (!Term(v)) return false;
+                for (;;)
+                {
+                    Skip();
+                    if (i < s.size() && (s[i] == '+' || s[i] == '-'))
+                    {
+                        char op = s[i++];
+                        int64_t r;
+                        if (!Term(r)) return false;
+                        v = op == '+' ? v + r : v - r;
+                    }
+                    else if (i < s.size() && s[i] == '|')
+                    {
+                        ++i;
+                        int64_t r;
+                        if (!Term(r)) return false;
+                        v |= r;
+                    }
+                    else if (i < s.size() && s[i] == '&')
+                    {
+                        ++i;
+                        int64_t r;
+                        if (!Term(r)) return false;
+                        v &= r;
+                    }
+                    else return true;
+                }
+            }
+
+            bool Term(int64_t& v)
+            {
+                if (!Unary(v)) return false;
+                for (;;)
+                {
+                    Skip();
+                    if (i < s.size() && (s[i] == '*' || s[i] == '/'))
+                    {
+                        char op = s[i++];
+                        int64_t r;
+                        if (!Unary(r)) return false;
+                        if (op == '/' && r == 0) { error = "division by zero"; return false; }
+                        v = op == '*' ? v * r : v / r;
+                    }
+                    else if (i + 1 < s.size() && (s.compare(i, 2, "<<") == 0 || s.compare(i, 2, ">>") == 0))
+                    {
+                        bool left = s[i] == '<';
+                        i += 2;
+                        int64_t r;
+                        if (!Unary(r)) return false;
+                        v = left ? int64_t(uint64_t(v) << r) : (v >> r);
+                    }
+                    else return true;
+                }
+            }
+
+            bool Unary(int64_t& v)
+            {
+                Skip();
+                if (i < s.size() && s[i] == '-') { ++i; if (!Unary(v)) return false; v = -v; return true; }
+                if (i < s.size() && s[i] == '+') { ++i; return Unary(v); }
+                if (i < s.size() && s[i] == '~') { ++i; if (!Unary(v)) return false; v = ~v; return true; }
+                return Primary(v);
+            }
+
+            bool Primary(int64_t& v)
+            {
+                Skip();
+                if (i >= s.size()) { error = "expected a value"; return false; }
+                char c = s[i];
+                if (c == '(')
+                {
+                    ++i;
+                    if (!Expr(v)) return false;
+                    Skip();
+                    if (i >= s.size() || s[i] != ')') { error = "missing )"; return false; }
+                    ++i;
+                    primaries += 2; // a parenthesised expression is never a bare register
+                    return true;
+                }
+                if (std::isdigit((unsigned char)c))
+                {
+                    size_t start = i;
+                    uint64_t value = 0;
+                    if (c == '0' && i + 1 < s.size() && (s[i + 1] == 'x' || s[i + 1] == 'X'))
+                    {
+                        i += 2;
+                        size_t digits = i;
+                        while (i < s.size() && std::isxdigit((unsigned char)s[i]))
+                        {
+                            char d = s[i++];
+                            value = value * 16 + (std::isdigit((unsigned char)d) ? d - '0' : (std::tolower(d) - 'a' + 10));
+                        }
+                        if (i == digits) { error = "bad hex number"; return false; }
+                    }
+                    else
+                    {
+                        while (i < s.size() && std::isdigit((unsigned char)s[i]))
+                            value = value * 10 + (s[i++] - '0');
+                    }
+                    if (i < s.size() && (std::isalpha((unsigned char)s[i]) || s[i] == '_'))
+                    {
+                        error = "bad number '" + s.substr(start) + "'";
+                        return false;
+                    }
+                    v = int64_t(value);
+                    primaries++;
+                    lastRegClass = 0;
+                    return true;
+                }
+                if (std::isalpha((unsigned char)c) || c == '_' || c == '.')
+                {
+                    size_t start = i;
+                    while (i < s.size() && (std::isalnum((unsigned char)s[i]) || s[i] == '_' || s[i] == '.'))
+                        ++i;
+                    std::string id = s.substr(start, i - start);
+                    primaries++;
+                    lastRegClass = 0;
+                    auto regNumber = [&](const char* prefix, int max, char cls) -> bool
+                        {
+                            size_t n = strlen(prefix);
+                            if (id.size() <= n || id.compare(0, n, prefix) != 0) return false;
+                            for (size_t k = n; k < id.size(); k++)
+                                if (!std::isdigit((unsigned char)id[k])) return false;
+                            int num = std::atoi(id.c_str() + n);
+                            if (num > max) return false;
+                            v = num;
+                            lastRegClass = cls;
+                            return true;
+                        };
+                    if (regNumber("cr", 7, 'c') || regNumber("r", 31, 'r') || regNumber("f", 31, 'f') || regNumber("v", 127, 'v'))
+                        return true;
+                    static const struct { const char* name; int value; } crBits[] = {
+                        { "lt", 0 }, { "gt", 1 }, { "eq", 2 }, { "so", 3 }, { "un", 3 } };
+                    for (auto& b : crBits)
+                        if (id == b.name) { v = b.value; return true; }
+                    if (labels && labels(id, v)) { usedLabel = true; return true; }
+                    error = "unknown symbol '" + id + "'";
+                    return false;
+                }
+                error = std::string("unexpected '") + c + "'";
+                return false;
+            }
+        };
+
+    }
+
+    bool Assembler::Evaluate(const std::string& text, const LabelLookup& labels, int64_t& value,
+        char& regClass, bool& usedLabel, std::string& error)
+    {
+        Parser p{ text, 0, labels };
+        if (!p.Expr(value)) { error = p.error; return false; }
+        p.Skip();
+        if (p.i != text.size()) { error = "junk after expression: '" + text.substr(p.i) + "'"; return false; }
+        regClass = p.primaries == 1 ? p.lastRegClass : 0;
+        usedLabel = p.usedLabel;
+        return true;
+    }
+
+    Assembler::Assembler()
+    {
+        dialect_ = rxt_dialect();
+        int count = 0;
+        const powerpc_opcode* ops = rxt_opcodes(&count);
+        for (int i = 0; i < count; i++)
+        {
+            if ((ops[i].flags & dialect_) == 0)
+                continue;
+            byName_[ops[i].name].push_back(&ops[i]);
+        }
+    }
+
+    // gas's PowerPC macros (powerpc_macros in ppc-dis.c), written out.
+    bool Assembler::Expand(const std::string& mnemonic, const std::vector<std::string>& g,
+        std::string& outMnemonic, std::vector<std::string>& outGroups, std::string& error) const
+    {
+        std::string base = mnemonic;
+        bool dot = !base.empty() && base.back() == '.';
+        if (dot) base.pop_back();
+
+        struct Macro { const char* name; int args; };
+        static const Macro macros[] = {
+            { "extldi", 4 }, { "extrdi", 4 }, { "insrdi", 4 }, { "rotrdi", 3 }, { "sldi", 3 }, { "srdi", 3 },
+            { "clrrdi", 3 }, { "clrlsldi", 4 }, { "extlwi", 4 }, { "extrwi", 4 }, { "inslwi", 4 }, { "insrwi", 4 },
+            { "rotrwi", 3 }, { "slwi", 3 }, { "srwi", 3 }, { "clrrwi", 3 }, { "clrlslwi", 4 } };
+        const Macro* m = nullptr;
+        for (auto& x : macros)
+            if (base == x.name) m = &x;
+        if (!m)
+            return false;
+        if ((int)g.size() != m->args)
+        {
+            error = "macro " + mnemonic + " takes " + std::to_string(m->args) + " operands";
+            return true;
+        }
+        int64_t a = 0, b = 0;
+        char rc; bool ul;
+        if (!Evaluate(g[2], nullptr, a, rc, ul, error)) return true;
+        if (m->args == 4 && !Evaluate(g[3], nullptr, b, rc, ul, error)) return true;
+        auto n = [](int64_t v) { return std::to_string(v); };
+        std::string ins;
+        std::vector<std::string> o = { g[0], g[1] };
+        // a = first numeric operand (n), b = second (b, or n for the clrls forms)
+        if (base == "extldi") { ins = "rldicr"; o.push_back(n(b)); o.push_back(n(a - 1)); }
+        else if (base == "extrdi") { ins = "rldicl"; o.push_back(n(b + a)); o.push_back(n(64 - a)); }
+        else if (base == "insrdi") { ins = "rldimi"; o.push_back(n(64 - (b + a))); o.push_back(n(b)); }
+        else if (base == "rotrdi") { ins = "rldicl"; o.push_back(n((64 - a) & 63)); o.push_back("0"); }
+        else if (base == "sldi") { ins = "rldicr"; o.push_back(n(a)); o.push_back(n(63 - a)); }
+        else if (base == "srdi") { ins = "rldicl"; o.push_back(n((64 - a) & 63)); o.push_back(n(a)); }
+        else if (base == "clrrdi") { ins = "rldicr"; o.push_back("0"); o.push_back(n(63 - a)); }
+        else if (base == "clrlsldi") { ins = "rldic"; o.push_back(n(b)); o.push_back(n(a - b)); }
+        else if (base == "extlwi") { ins = "rlwinm"; o.push_back(n(b)); o.push_back("0"); o.push_back(n(a - 1)); }
+        else if (base == "extrwi") { ins = "rlwinm"; o.push_back(n((b + a) & 31)); o.push_back(n(32 - a)); o.push_back("31"); }
+        else if (base == "inslwi") { ins = "rlwimi"; o.push_back(n((32 - b) & 31)); o.push_back(n(b)); o.push_back(n(b + a - 1)); }
+        else if (base == "insrwi") { ins = "rlwimi"; o.push_back(n((32 - (b + a)) & 31)); o.push_back(n(b)); o.push_back(n(b + a - 1)); }
+        else if (base == "rotrwi") { ins = "rlwinm"; o.push_back(n((32 - a) & 31)); o.push_back("0"); o.push_back("31"); }
+        else if (base == "slwi") { ins = "rlwinm"; o.push_back(n(a)); o.push_back("0"); o.push_back(n(31 - a)); }
+        else if (base == "srwi") { ins = "rlwinm"; o.push_back(n((32 - a) & 31)); o.push_back(n(a)); o.push_back("31"); }
+        else if (base == "clrrwi") { ins = "rlwinm"; o.push_back("0"); o.push_back("0"); o.push_back(n(31 - a)); }
+        else if (base == "clrlslwi") { ins = "rlwinm"; o.push_back(n(b)); o.push_back(n(a - b)); o.push_back(n(31 - b)); }
+        outMnemonic = ins + (dot ? "." : "");
+        outGroups = o;
+        return true;
+    }
+
+    bool Assembler::TryOpcode(const powerpc_opcode* op, const std::vector<Token>& tokens, size_t groupCount,
+        uint32_t pc, const LabelLookup& labels, uint32_t& word, std::string& error, bool& clean) const
+    {
+        clean = true;
+        std::string warn;
+
+        bool skipOptional = false;
+        for (int k = 0; op->operands[k]; k++)
+        {
+            rxt_operand o;
+            rxt_operand_info(op->operands[k], &o);
+            if (o.flags & RXT_OPERAND_OPTIONAL)
+            {
+                size_t expected = 0;
+                for (int j = 0; op->operands[j]; j++)
+                {
+                    rxt_operand q;
+                    rxt_operand_info(op->operands[j], &q);
+                    if (!(q.flags & RXT_OPERAND_FAKE)) expected++;
+                }
+                if (groupCount < expected) skipOptional = true;
+                break;
+            }
+        }
+
+        uint32_t insn = (uint32_t)op->opcode;
+        size_t ti = 0;
+        int nextIndex = 0;
+        for (int k = 0; op->operands[k]; k++)
+        {
+            int index = nextIndex ? nextIndex : op->operands[k];
+            nextIndex = 0;
+            rxt_operand o;
+            rxt_operand_info(index, &o);
+            const char* errmsg = nullptr;
+
+            if (o.flags & RXT_OPERAND_FAKE)
+            {
+                insn = rxt_insert(index, insn, 0, &errmsg);
+                if (errmsg) { clean = false; warn = errmsg; }
+                continue;
+            }
+            if ((o.flags & RXT_OPERAND_OPTIONAL) && skipOptional)
+            {
+                if (o.has_insert)
+                    insn = rxt_insert(index, insn, 0, &errmsg);
+                if (o.flags & RXT_OPERAND_NEXT)
+                    nextIndex = op->operands[k] + 1;
+                continue;
+            }
+            if (ti >= tokens.size())
+            {
+                error = "too few operands for " + std::string(op->name);
+                return false;
+            }
+            const Token& tok = tokens[ti++];
+            bool wantParenOuter = (o.flags & RXT_OPERAND_PARENS) != 0;
+            if (wantParenOuter != tok.parenOuter)
+            {
+                error = "operand form doesn't match " + std::string(op->name) + " (d(rA) expected " + (wantParenOuter ? "here)" : "elsewhere)");
+                return false;
+            }
+            int64_t value;
+            char regClass;
+            bool usedLabel;
+            if (!Evaluate(tok.text, labels, value, regClass, usedLabel, error))
+                return false;
+
+            bool isGpr = (o.flags & (RXT_OPERAND_GPR | RXT_OPERAND_GPR_0)) != 0;
+            bool isFpr = (o.flags & RXT_OPERAND_FPR) != 0;
+            bool isVr = (o.flags & RXT_OPERAND_VR) != 0;
+            bool isCr = (o.flags & RXT_OPERAND_CR) != 0;
+            if ((regClass == 'r' && !isGpr) || (regClass == 'f' && !isFpr) || (regClass == 'v' && !isVr) || (regClass == 'c' && !isCr))
+            {
+                error = "register '" + tok.text + "' doesn't fit operand " + std::to_string(k + 1) + " of " + op->name;
+                return false;
+            }
+            if ((isGpr || isFpr || isVr) && regClass == 0 && usedLabel)
+            {
+                error = "label used as a register";
+                return false;
+            }
+            // a CR field operand (bitm 7) written crN is the field number; a CR bit operand takes 4*crN+bit
+            if (o.flags & RXT_OPERAND_RELATIVE)
+                value -= int64_t(pc);
+
+            if (!o.has_insert)
+            {
+                int64_t bitm = o.bitm;
+                int64_t right = bitm & -bitm;
+                int64_t min = 0, max = bitm;
+                if (o.flags & RXT_OPERAND_SIGNED)
+                {
+                    max = (bitm >> 1) & -right;
+                    min = -(max + right);
+                    if (o.flags & RXT_OPERAND_SIGNOPT)
+                        max = bitm; // the full unsigned range is accepted too
+                }
+                if (o.flags & RXT_OPERAND_PLUS1) max++;
+                if (o.flags & RXT_OPERAND_NEGATIVE) { int64_t t = min; min = -max; max = -t; }
+                if ((value & (right - 1)) != 0 || value < min || value > max)
+                {
+                    clean = false;
+                    warn = "operand " + std::to_string(k + 1) + " (" + tok.text + ") out of range";
+                }
+            }
+            insn = rxt_insert(index, insn, (long)value, &errmsg);
+            if (errmsg) { clean = false; warn = errmsg; }
+        }
+        if (ti != tokens.size())
+        {
+            error = "too many operands for " + std::string(op->name);
+            return false;
+        }
+        word = insn;
+        if (!clean) error = warn;
+        return true;
+    }
+
+    bool Assembler::Assemble(const std::string& mnemonicIn, const std::string& operands, uint32_t pc,
+        const LabelLookup& labels, uint32_t& word, std::string& error) const
+    {
+        std::string mnemonic = mnemonicIn;
+        std::vector<std::string> groups = SplitOperands(operands);
+
+        // Xenon spellings that the binutils table names differently or writes with an extra operand.
+        if (mnemonic == "dcbz128")
+            mnemonic = "dcbzl"; // dcbz with the L bit: Xenia's dcbz128 (0x7C2007EC)
+        if ((mnemonic == "vupkhsb128" || mnemonic == "vupklsb128") && groups.size() == 2)
+            groups.push_back("v0"); // the VA field is 0 for the byte forms (0x60 selects the halfword ones)
+
+        // "." is the current address; xer/lr/ctr are SPR numbers (mfspr r3, lr)
+        LabelLookup outer = labels;
+        LabelLookup lookupWithPc = [&](const std::string& name, int64_t& v) -> bool
+            {
+                if (name == ".") { v = pc; return true; }
+                if (outer && outer(name, v)) return true;
+                if (name == "xer") { v = 1; return true; }
+                if (name == "lr") { v = 8; return true; }
+                if (name == "ctr") { v = 9; return true; }
+                return false;
+            };
+
+        if (byName_.find(mnemonic) == byName_.end())
+        {
+            std::string m2;
+            std::vector<std::string> g2;
+            std::string err;
+            if (Expand(mnemonic, groups, m2, g2, err))
+            {
+                if (!err.empty()) { error = err; return false; }
+                mnemonic = m2;
+                groups = g2;
+            }
+        }
+
+        auto it = byName_.find(mnemonic);
+        if (it == byName_.end())
+        {
+            error = "unknown mnemonic '" + mnemonic + "'";
+            return false;
+        }
+
+        std::vector<Token> tokens;
+        for (auto& g : groups)
+        {
+            // d(rA): the last top-level parenthesised suffix
+            size_t close = g.size();
+            if (!g.empty() && g.back() == ')')
+            {
+                int depth = 0;
+                size_t open = std::string::npos;
+                for (size_t k = g.size(); k-- > 0;)
+                {
+                    if (g[k] == ')') depth++;
+                    else if (g[k] == '(') { if (--depth == 0) { open = k; break; } }
+                }
+                if (open != std::string::npos && open > 0)
+                {
+                    std::string outer = Trim(g.substr(0, open));
+                    std::string inner = Trim(g.substr(open + 1, close - open - 2));
+                    // "(x)" alone, or an expression like "(a)+(b)": only a register-ish inner part is d(rA)
+                    char rc; bool ul; int64_t v; std::string e;
+                    bool innerIsReg = Evaluate(inner, nullptr, v, rc, ul, e) && (rc == 'r' || (rc == 0 && inner.find_first_not_of("0123456789") == std::string::npos));
+                    char last = outer.empty() ? 0 : outer.back();
+                    bool outerEndsWithOperator = last == '+' || last == '-' || last == '*' || last == '/' || last == '(' || last == '&' || last == '|';
+                    if (innerIsReg && !outerEndsWithOperator)
+                    {
+                        tokens.push_back({ outer, true, false });
+                        tokens.push_back({ inner, false, true });
+                        continue;
+                    }
+                }
+            }
+            tokens.push_back({ g, false, false });
+        }
+
+        std::string firstError, uncleanError;
+        bool haveUnclean = false;
+        uint32_t uncleanWord = 0;
+        for (const powerpc_opcode* op : it->second)
+        {
+            uint32_t w;
+            std::string err;
+            bool clean;
+            if (TryOpcode(op, tokens, groups.size(), pc, lookupWithPc, w, err, clean))
+            {
+                if (clean)
+                {
+                    word = w;
+                    return true;
+                }
+                if (!haveUnclean)
+                {
+                    haveUnclean = true;
+                    uncleanWord = w;
+                    uncleanError = err;
+                }
+            }
+            else if (firstError.empty())
+                firstError = err;
+        }
+        if (haveUnclean)
+        {
+            word = uncleanWord;
+            error = "warning: " + uncleanError;
+            return true;
+        }
+        error = firstError;
+        return false;
+    }
+}
diff --git a/ReXenonTests/assembler.h b/ReXenonTests/assembler.h
new file mode 100644
index 0000000..572fd2b
--- /dev/null
+++ b/ReXenonTests/assembler.h
@@ -0,0 +1,55 @@
+#pragma once
+// A small PowerPC assembler built on the disassembler's own opcode/operand tables (ppc-dis.c),
+// enough for Xenia's instruction tests: one instruction per call, gas operand rules
+// (optional operands, PPC_OPERAND_NEXT, d(rA)), registers, numbers, cr bit names and labels.
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+struct powerpc_opcode;
+
+namespace rxt
+{
+    // Resolves a symbol (label) to an absolute guest address. Returns false if unknown.
+    using LabelLookup = std::function<bool(const std::string&, int64_t&)>;
+
+    class Assembler
+    {
+    public:
+        Assembler();
+
+        // Assembles one instruction (mnemonic plus the operand text after it) at pc.
+        bool Assemble(const std::string& mnemonic, const std::string& operands, uint32_t pc,
+            const LabelLookup& labels, uint32_t& word, std::string& error) const;
+
+        // Evaluates an expression: numbers, registers (r/f/v/cr), cr bit names, labels, + - * ( ).
+        static bool Evaluate(const std::string& text, const LabelLookup& labels, int64_t& value,
+            char& regClass, bool& usedLabel, std::string& error);
+
+        int dialect() const { return dialect_; }
+
+    private:
+        struct Token
+        {
+            std::string text;
+            bool parenOuter = false; // the d in d(rA)
+            bool parenInner = false; // the rA in d(rA)
+        };
+
+        bool Expand(const std::string& mnemonic, const std::vector<std::string>& groups,
+            std::string& outMnemonic, std::vector<std::string>& outGroups, std::string& error) const;
+
+        bool TryOpcode(const powerpc_opcode* op, const std::vector<Token>& tokens, size_t groupCount,
+            uint32_t pc, const LabelLookup& labels, uint32_t& word, std::string& error, bool& clean) const;
+
+        std::unordered_map<std::string, std::vector<const powerpc_opcode*>> byName_;
+        int dialect_ = 0;
+    };
+
+    // Splits operand text on top-level commas.
+    std::vector<std::string> SplitOperands(const std::string& text);
+    std::string Trim(const std::string& s);
+}
diff --git a/ReXenonTests/driver.cpp b/ReXenonTests/driver.cpp
new file mode 100644
index 0000000..32a69f9
--- /dev/null
+++ b/ReXenonTests/driver.cpp
@@ -0,0 +1,714 @@
+// ReXenonTests driver: assembles Xenia's PPC instruction tests, recompiles each test function
+// with ReXenon's emitter (Recompiler::Recompile, default config) and writes, per suite:
+//   gen/<suite>.cpp  the recompiled functions plus a table (rxt_functions)
+//   gen/<suite>.vec  the tests: registers/memory in, expected registers/memory out
+//   gen/<suite>.map  line ranges of each function in the .cpp (to drop one that fails to compile)
+// plus manifest.tsv (every test and its static status), encoder.txt and problems.txt.
+//
+// Usage: ReXenonTestDriver <xenia testing dir> <out dir> [suite name filter]
+#include "pch.h"
+#include "recompiler.h"
+#include "assembler.h"
+
+#include <cinttypes>
+#include <set>
+
+using namespace rxt;
+
+namespace
+{
+    constexpr uint32_t kBase = 0x82010000;
+
+    struct Line
+    {
+        int number = 0;
+        std::string mnemonic;    // empty for a .long
+        std::string operands;
+        std::string longExpr;    // .long operand
+        uint32_t address = 0;
+        uint32_t word = 0;
+        bool ok = false;
+        bool warned = false;
+        std::string error;
+    };
+
+    struct Annotation
+    {
+        std::string key, value;
+    };
+
+    struct TestCase
+    {
+        std::string label;       // test_foo
+        std::string name;        // foo (Xenia's name, used by skip.txt)
+        uint32_t start = 0, end = 0;
+        size_t firstLine = 0, lastLine = 0; // [first, last) into lines
+        std::vector<Annotation> annotations;
+    };
+
+    struct Macro
+    {
+        std::vector<std::string> params;
+        std::vector<std::string> body;
+    };
+
+    std::string StripComment(const std::string& s)
+    {
+        size_t hash = s.find('#');
+        return hash == std::string::npos ? s : s.substr(0, hash);
+    }
+
+    struct Suite
+    {
+        std::string name;
+        std::vector<Line> lines;
+        std::vector<TestCase> tests;
+        std::unordered_map<std::string, uint32_t> labels;
+        std::vector<std::string> parseErrors;
+    };
+
+    void ParseLine(Suite& suite, const std::unordered_map<std::string, Macro>& macros, std::string text, int number, uint32_t& pc, int depth);
+
+    bool ParseFile(const std::filesystem::path& path, Suite& suite)
+    {
+        std::ifstream in(path);
+        if (!in) return false;
+        std::unordered_map<std::string, Macro> macros;
+        std::string raw;
+        int number = 0;
+        uint32_t pc = kBase;
+        Macro* defining = nullptr;
+        while (std::getline(in, raw))
+        {
+            ++number;
+            if (!raw.empty() && raw.back() == '\r') raw.pop_back();
+            std::string t = Trim(raw);
+
+            if (defining)
+            {
+                if (Trim(StripComment(t)) == ".endm") { defining = nullptr; continue; }
+                defining->body.push_back(t);
+                continue;
+            }
+
+            if (t.rfind("#_", 0) == 0)
+            {
+                // annotation: "#_ KEY value"
+                std::string rest = Trim(t.substr(2));
+                size_t sp = rest.find(' ');
+                if (sp != std::string::npos && !suite.tests.empty())
+                    suite.tests.back().annotations.push_back({ rest.substr(0, sp), Trim(rest.substr(sp + 1)) });
+                continue;
+            }
+            t = Trim(StripComment(t));
+            if (t.empty()) continue;
+
+            if (t.rfind(".macro", 0) == 0)
+            {
+                std::string decl = Trim(t.substr(6));
+                size_t sp = decl.find_first_of(" \t");
+                std::string mname = decl.substr(0, sp);
+                Macro m;
+                if (sp != std::string::npos)
+                    for (auto& p : SplitOperands(decl.substr(sp + 1)))
+                        m.params.push_back(p);
+                defining = &macros[mname];
+                *defining = m;
+                continue;
+            }
+            ParseLine(suite, macros, t, number, pc, 0);
+        }
+        // close the last test
+        if (!suite.tests.empty())
+        {
+            suite.tests.back().end = pc;
+            suite.tests.back().lastLine = suite.lines.size();
+        }
+        return true;
+    }
+
+    void ParseLine(Suite& suite, const std::unordered_map<std::string, Macro>& macros, std::string t, int number, uint32_t& pc, int depth)
+    {
+        // labels (possibly several, possibly followed by an instruction)
+        for (;;)
+        {
+            size_t colon = t.find(':');
+            if (colon == std::string::npos) break;
+            std::string label = Trim(t.substr(0, colon));
+            bool ident = !label.empty() && label.find_first_of(" \t,()") == std::string::npos;
+            if (!ident) break;
+            if (label.rfind("test_", 0) == 0)
+            {
+                if (!suite.tests.empty())
+                {
+                    suite.tests.back().end = pc;
+                    suite.tests.back().lastLine = suite.lines.size();
+                }
+                TestCase tc;
+                tc.label = label;
+                tc.name = label.substr(5);
+                tc.start = pc;
+                tc.firstLine = suite.lines.size();
+                suite.tests.push_back(tc);
+            }
+            if (suite.labels.count(label))
+                suite.parseErrors.push_back(fmt::format("line {}: duplicate label {}", number, label));
+            suite.labels[label] = pc;
+            t = Trim(t.substr(colon + 1));
+        }
+        if (t.empty()) return;
+
+        size_t sp = t.find_first_of(" \t");
+        std::string mnemonic = t.substr(0, sp);
+        std::string operands = sp == std::string::npos ? "" : Trim(t.substr(sp + 1));
+
+        if (mnemonic[0] == '.')
+        {
+            if (mnemonic == ".long" || mnemonic == ".int" || mnemonic == ".word")
+            {
+                for (auto& e : SplitOperands(operands))
+                {
+                    Line l;
+                    l.number = number;
+                    l.longExpr = e;
+                    l.address = pc;
+                    pc += 4;
+                    suite.lines.push_back(l);
+                }
+            }
+            else if (mnemonic == ".globl" || mnemonic == ".global" || mnemonic == ".text" || mnemonic == ".section" || mnemonic == ".align" || mnemonic == ".p2align")
+            {
+                // nothing to place (alignment: everything is 4-byte already)
+            }
+            else
+                suite.parseErrors.push_back(fmt::format("line {}: unsupported directive {}", number, mnemonic));
+            return;
+        }
+
+        auto m = macros.find(mnemonic);
+        if (m != macros.end() && depth < 8)
+        {
+            auto args = SplitOperands(operands);
+            // longest parameter names first so \ab isn't replaced as \a + b
+            std::vector<size_t> order(m->second.params.size());
+            for (size_t i = 0; i < order.size(); i++) order[i] = i;
+            std::sort(order.begin(), order.end(), [&](size_t a, size_t b) { return m->second.params[a].size() > m->second.params[b].size(); });
+            for (auto bodyLine : m->second.body)
+            {
+                for (size_t i : order)
+                {
+                    std::string key = "\\" + m->second.params[i];
+                    std::string value = i < args.size() ? args[i] : "";
+                    for (size_t pos; (pos = bodyLine.find(key)) != std::string::npos;)
+                        bodyLine.replace(pos, key.size(), value);
+                }
+                bodyLine = Trim(StripComment(bodyLine));
+                if (!bodyLine.empty())
+                    ParseLine(suite, macros, bodyLine, number, pc, depth + 1);
+            }
+            return;
+        }
+
+        Line l;
+        l.number = number;
+        l.mnemonic = mnemonic;
+        l.operands = operands;
+        l.address = pc;
+        pc += 4;
+        suite.lines.push_back(l);
+    }
+
+    // ------------------------------------------------------------------ value parsing (Xenia's rules)
+
+    bool ParseU64(std::string s, uint64_t& v)
+    {
+        s = Trim(s);
+        while (!s.empty() && (s.back() == 'u' || s.back() == 'U' || s.back() == 'l' || s.back() == 'L'))
+            s.pop_back(); // 0x...ull
+        bool neg = false;
+        if (!s.empty() && s[0] == '-') { neg = true; s = s.substr(1); }
+        if (s.empty()) return false;
+        char* end = nullptr;
+        if (s.size() > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
+            v = strtoull(s.c_str() + 2, &end, 16);
+        else
+            v = strtoull(s.c_str(), &end, 10);
+        if (end == nullptr || *end != 0) return false;
+        if (neg) v = uint64_t(-int64_t(v));
+        return true;
+    }
+
+    bool ParseDoubleBits(std::string s, uint64_t& bits, bool& isHex)
+    {
+        s = Trim(s);
+        isHex = s.find("0x") != std::string::npos || s.find("0X") != std::string::npos;
+        if (isHex) return ParseU64(s, bits);
+        char* end = nullptr;
+        double d = strtod(s.c_str(), &end);
+        if (end == nullptr || *end != 0) return false;
+        memcpy(&bits, &d, 8);
+        return true;
+    }
+
+    bool ParseVec(std::string s, uint32_t w[4])
+    {
+        size_t close = s.find(']');
+        if (close != std::string::npos) s = s.substr(0, close + 1); // "[...]  # comment"
+        s = Trim(s);
+        if (s.size() < 2 || s.front() != '[' || s.back() != ']') return false;
+        auto parts = SplitOperands(s.substr(1, s.size() - 2));
+        if (parts.size() != 4) return false;
+        for (int i = 0; i < 4; i++)
+        {
+            std::string p = Trim(parts[i]);
+            if (p.size() > 2 && p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) p = p.substr(2);
+            char* end = nullptr;
+            w[i] = uint32_t(strtoul(p.c_str(), &end, 16));
+            if (end == nullptr || *end != 0) return false;
+        }
+        return true;
+    }
+
+    // Xenia's ParseMemoryBytes: after spaces, every two characters are read as hex (strtoul),
+    // so "[AB, CD]" reads as 00 0B CD 00 ...; the expected values were written against that.
+    std::string MemoryHex(const std::string& text)
+    {
+        std::string out;
+        size_t i = 0;
+        while (i < text.size())
+        {
+            while (i < text.size() && text[i] == ' ') ++i;
+            if (i >= text.size()) break;
+            std::string pair = text.substr(i, 2);
+            out += fmt::format("{:02X}", uint8_t(strtoul(pair.c_str(), nullptr, 16)));
+            i += 2;
+        }
+        return out;
+    }
+
+    bool RegisterLine(char dir, const std::string& value, std::string& out, std::string& error)
+    {
+        size_t sp = value.find(' ');
+        if (sp == std::string::npos) { error = "no value"; return false; }
+        std::string reg = value.substr(0, sp);
+        std::string v = Trim(value.substr(sp + 1));
+        if (size_t hash = v.find('#'); hash != std::string::npos && v[0] != '[')
+            v = Trim(v.substr(0, hash));
+        if (reg == "cr" || reg == "xer")
+        {
+            uint64_t x;
+            if (!ParseU64(v, x)) { error = "bad value " + v; return false; }
+            out = fmt::format("{} {} {:X}", dir, reg, x);
+            return true;
+        }
+        if (reg.size() < 2 || !std::isdigit((unsigned char)reg[1])) { error = "unknown register " + reg; return false; }
+        int n = std::atoi(reg.c_str() + 1);
+        switch (reg[0])
+        {
+        case 'r':
+        {
+            if (n > 31) break;
+            uint64_t x;
+            if (!ParseU64(v, x)) { error = "bad value " + v; return false; }
+            out = fmt::format("{} {} {:X}", dir, reg, x);
+            return true;
+        }
+        case 'f':
+        {
+            if (n > 31) break;
+            uint64_t bits;
+            bool isHex;
+            if (!ParseDoubleBits(v, bits, isHex)) { error = "bad value " + v; return false; }
+            if (dir == 'O')
+                out = fmt::format("O {} {} {:X}", reg, isHex ? 'b' : 'd', bits);
+            else
+                out = fmt::format("I {} {:X}", reg, bits);
+            return true;
+        }
+        case 'v':
+        {
+            if (n > 127) break;
+            uint32_t w[4];
+            if (!ParseVec(v, w)) { error = "bad vector " + v; return false; }
+            out = fmt::format("{} {} {:X} {:X} {:X} {:X}", dir, reg, w[0], w[1], w[2], w[3]);
+            return true;
+        }
+        }
+        error = "unknown register " + reg;
+        return false;
+    }
+
+    std::string Sanitize(const std::string& s)
+    {
+        std::string o;
+        for (char c : s) o += (c == '\t' || c == '\n' || c == '\r') ? ' ' : c;
+        return o;
+    }
+
+    std::string Mnemonics(const Suite& suite, const TestCase& tc)
+    {
+        std::set<std::string> m;
+        for (size_t i = tc.firstLine; i < tc.lastLine; i++)
+            m.insert(suite.lines[i].mnemonic.empty() ? ".long" : suite.lines[i].mnemonic);
+        std::string s;
+        for (auto& x : m) { if (!s.empty()) s += ","; s += x; }
+        return s;
+    }
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 3)
+    {
+        fmt::println("usage: ReXenonTestDriver <xenia testing dir> <out dir> [suite filter]");
+        return 2;
+    }
+    std::filesystem::path testDir = argv[1];
+    std::filesystem::path outDir = argv[2];
+    std::string filter = argc > 3 ? argv[3] : "";
+    std::filesystem::create_directories(outDir / "gen");
+
+    std::unordered_set<std::string> skip;
+    {
+        std::ifstream s(testDir / "skip.txt");
+        std::string line;
+        while (std::getline(s, line))
+        {
+            line = Trim(line);
+            if (!line.empty() && line[0] != '#') skip.insert(line);
+        }
+    }
+
+    std::vector<std::filesystem::path> files;
+    for (auto& e : std::filesystem::directory_iterator(testDir))
+    {
+        auto fn = e.path().filename().string();
+        if (e.path().extension() == ".s" && fn.rfind("instr_", 0) == 0 && (filter.empty() || fn.find(filter) != std::string::npos))
+            files.push_back(e.path());
+    }
+    std::sort(files.begin(), files.end());
+
+    Assembler assembler;
+
+    FILE* manifest = fopen((outDir / "manifest.tsv").string().c_str(), "w");
+    FILE* encoderLog = fopen((outDir / "encoder.txt").string().c_str(), "w");
+    FILE* problemsLog = fopen((outDir / "problems.txt").string().c_str(), "w");
+    FILE* suitesList = fopen((outDir / "suites.txt").string().c_str(), "w");
+
+    // encoder statistics, over every instruction line (each line once, as written in the file)
+    size_t linesTotal = 0, linesAssembled = 0, linesWarned = 0, linesDecoded = 0, linesStrict = 0, linesLoose = 0, longsTotal = 0;
+    std::set<std::string> uniqueTotal, uniqueStrictOrLoose;
+    std::vector<std::string> roundTripFailures;
+    std::set<std::string> aliasSeen;
+    std::vector<std::string> aliasLines;
+    size_t testsTotal = 0, testsSkipped = 0, testsEncFailed = 0, testsRunnable = 0, functionsTotal = 0;
+
+    for (auto& path : files)
+    {
+        Suite suite;
+        suite.name = path.stem().string();
+        if (!ParseFile(path, suite))
+        {
+            fmt::println("can't read {}", path.string());
+            continue;
+        }
+        for (auto& e : suite.parseErrors)
+            fmt::println(encoderLog, "{}: {}", suite.name, e);
+
+        auto lookup = [&](const std::string& name, int64_t& v) -> bool
+            {
+                auto it = suite.labels.find(name);
+                if (it == suite.labels.end()) return false;
+                v = it->second;
+                return true;
+            };
+
+        // assemble
+        for (auto& l : suite.lines)
+        {
+            if (!l.mnemonic.empty())
+            {
+                ++linesTotal;
+                std::string err;
+                l.ok = assembler.Assemble(l.mnemonic, l.operands, l.address, lookup, l.word, err);
+                if (l.ok && !err.empty()) { l.warned = true; ++linesWarned; fmt::println(encoderLog, "{}:{}: {} {}: {}", suite.name, l.number, l.mnemonic, l.operands, err); }
+                if (!l.ok) { l.error = err; fmt::println(encoderLog, "{}:{}: ENCODE FAILED {} {}: {}", suite.name, l.number, l.mnemonic, l.operands, err); }
+                else ++linesAssembled;
+            }
+            else
+            {
+                ++longsTotal;
+                int64_t v;
+                char rc;
+                bool ul;
+                std::string err;
+                l.ok = Assembler::Evaluate(l.longExpr, lookup, v, rc, ul, err);
+                l.word = uint32_t(v);
+                if (!l.ok) { l.error = err; fmt::println(encoderLog, "{}:{}: .long {}: {}", suite.name, l.number, l.longExpr, err); }
+            }
+        }
+
+        // round trip through XenonUtils' disassembler
+        for (auto& l : suite.lines)
+        {
+            if (l.mnemonic.empty() || !l.ok) continue;
+            std::string key = l.mnemonic + " " + l.operands;
+            uniqueTotal.insert(key);
+            uint32_t be = ByteSwap(l.word);
+            ppc_insn insn;
+            ppc::Disassemble(&be, 4, l.address, insn);
+            if (insn.opcode == nullptr)
+            {
+                roundTripFailures.push_back(fmt::format("{}:{}: {} {} -> {:08X} doesn't decode", suite.name, l.number, l.mnemonic, l.operands, l.word));
+                continue;
+            }
+            ++linesDecoded;
+
+            // strict: same mnemonic and the same operand values
+            bool strict = false;
+            if (insn.opcode->name == l.mnemonic)
+            {
+                auto flatten = [&](const std::string& ops, std::vector<int64_t>& out) -> bool
+                    {
+                        for (auto& g : SplitOperands(ops))
+                        {
+                            std::string a = g, b;
+                            if (!g.empty() && g.back() == ')')
+                            {
+                                size_t open = g.rfind('(');
+                                if (open != std::string::npos && open > 0) { a = g.substr(0, open); b = g.substr(open + 1, g.size() - open - 2); }
+                            }
+                            for (auto* part : { &a, &b })
+                            {
+                                if (part->empty()) continue;
+                                int64_t v; char rc; bool ul; std::string e;
+                                if (!Assembler::Evaluate(*part, lookup, v, rc, ul, e)) return false;
+                                out.push_back(v);
+                            }
+                        }
+                        return true;
+                    };
+                std::vector<int64_t> a, b;
+                strict = flatten(l.operands, a) && flatten(insn.op_str, b) && a == b;
+            }
+            // loose: assembling the disassembler's text gives the same word back
+            bool loose = false;
+            if (!strict)
+            {
+                uint32_t w2;
+                std::string err;
+                loose = assembler.Assemble(insn.opcode->name, insn.op_str, l.address, lookup, w2, err) && w2 == l.word;
+            }
+            if (strict) ++linesStrict;
+            else if (loose)
+            {
+                ++linesLoose;
+                if (aliasSeen.insert(key).second)
+                    aliasLines.push_back(fmt::format("{}:{}: {} {} -> {:08X} -> {} {}", suite.name, l.number, l.mnemonic, l.operands, l.word, insn.opcode->name, insn.op_str));
+            }
+            if (strict || loose)
+                uniqueStrictOrLoose.insert(key);
+            else
+                roundTripFailures.push_back(fmt::format("{}:{}: {} {} -> {:08X} -> {} {}", suite.name, l.number, l.mnemonic, l.operands, l.word, insn.opcode->name, insn.op_str));
+        }
+
+        // code image: the whole file, as Xenia assembles it
+        uint32_t codeEnd = kBase;
+        for (auto& l : suite.lines) codeEnd = std::max(codeEnd, l.address + 4);
+        std::vector<uint8_t> code(codeEnd - kBase + 16, 0);
+        for (auto& l : suite.lines)
+        {
+            uint32_t be = ByteSwap(l.ok ? l.word : 0u);
+            memcpy(&code[l.address - kBase], &be, 4);
+        }
+
+        Recompiler recompiler;
+        // Recompiler options for the run (run.py --options): comma-separated config names.
+        if (const char* options = getenv("REXENON_TEST_OPTIONS"))
+        {
+            const std::string list = std::string(",") + options + ",";
+            recompiler.config.exactEstimates = list.find(",exact_estimates,") != std::string::npos;
+            recompiler.config.fusedMadd = list.find(",fused_madd,") != std::string::npos;
+        }
+        recompiler.image.base = 0;
+        recompiler.image.size = uint32_t(code.size());
+        recompiler.image.Map(".text", kBase, uint32_t(code.size()), SectionFlags_Code, code.data());
+
+        // functions: one per distinct test body; a body that branches outside itself or uses
+        // .long keeps its own copy (its meaning depends on where it is)
+        std::map<std::vector<uint32_t>, int> bodies;
+        std::vector<std::pair<uint32_t, uint32_t>> functions; // base, size
+        std::vector<int> testFunction(suite.tests.size(), -1);
+        std::vector<std::string> testStatus(suite.tests.size());
+        for (size_t ti = 0; ti < suite.tests.size(); ti++)
+        {
+            auto& tc = suite.tests[ti];
+            ++testsTotal;
+            if (skip.count(tc.name)) { testStatus[ti] = "SKIP\t"; ++testsSkipped; continue; }
+            std::string encError;
+            bool positionDependent = false;
+            std::vector<uint32_t> words;
+            for (size_t i = tc.firstLine; i < tc.lastLine; i++)
+            {
+                auto& l = suite.lines[i];
+                if (!l.ok && encError.empty())
+                    encError = fmt::format("line {}: {} {}: {}", l.number, l.mnemonic.empty() ? ".long" : l.mnemonic, l.mnemonic.empty() ? l.longExpr : l.operands, l.error);
+                if (l.mnemonic.empty()) positionDependent = true;
+                words.push_back(l.word);
+                uint32_t w = l.word;
+                uint32_t op = w >> 26;
+                if (op == 18 || op == 16)
+                {
+                    int64_t disp = op == 18 ? PPC_BI(w) : PPC_BD(w);
+                    int64_t target = (w & 2) ? disp : int64_t(l.address) + disp;
+                    if (target < tc.start || target >= tc.end) positionDependent = true;
+                }
+            }
+            if (!encError.empty()) { testStatus[ti] = "ENC\t" + Sanitize(encError); ++testsEncFailed; continue; }
+            if (tc.end <= tc.start) { testStatus[ti] = "ENC\tempty test"; ++testsEncFailed; continue; }
+            int fnIndex;
+            auto it = positionDependent ? bodies.end() : bodies.find(words);
+            if (it != bodies.end())
+                fnIndex = it->second;
+            else
+            {
+                fnIndex = int(functions.size());
+                functions.push_back({ tc.start, tc.end - tc.start });
+                if (!positionDependent) bodies.emplace(words, fnIndex);
+            }
+            testFunction[ti] = fnIndex;
+            testStatus[ti] = "RUN\t";
+        }
+
+        for (size_t i = 0; i < functions.size(); i++)
+            recompiler.image.symbols.emplace(fmt::format("f{}", i), functions[i].first, functions[i].second, Symbol_Function);
+
+        std::string cpp;
+        cpp += "// Generated by ReXenonTestDriver from " + path.filename().string() + "\n";
+        cpp += "#include \"rxt_runtime.h\"\n\n";
+        auto lineCount = [](const std::string& s) { return (size_t)std::count(s.begin(), s.end(), '\n'); };
+        std::string map;
+        std::vector<std::string> fnProblems(functions.size());
+        for (size_t i = 0; i < functions.size(); i++)
+        {
+            Function fn(functions[i].first, functions[i].second);
+            recompiler.out.clear();
+            size_t problemsBefore = recompiler.problems.size();
+            recompiler.Recompile(fn);
+            for (size_t p = problemsBefore; p < recompiler.problems.size(); p++)
+            {
+                fmt::println(problemsLog, "{} f{}: {}", suite.name, i, recompiler.problems[p]);
+                if (!fnProblems[i].empty()) fnProblems[i] += "; ";
+                fnProblems[i] += recompiler.problems[p];
+            }
+            cpp += fmt::format("#ifndef RXT_SKIP_F{}\n", i);
+            size_t startLine = lineCount(cpp) + 1;
+            cpp += recompiler.out;
+            size_t endLine = lineCount(cpp);
+            cpp += "#endif\n\n";
+            map += fmt::format("{} {} {}\n", i, startLine, endLine);
+        }
+        functionsTotal += functions.size();
+
+        cpp += "extern \"C\" const RxtEntry rxt_functions[] = {\n";
+        for (size_t i = 0; i < functions.size(); i++)
+            cpp += fmt::format("#ifndef RXT_SKIP_F{0}\n\t{{ \"f{0}\", f{0} }},\n#else\n\t{{ \"f{0}\", nullptr }},\n#endif\n", i);
+        cpp += "\t{ nullptr, nullptr }\n};\n";
+        cpp += fmt::format("extern \"C\" const int rxt_function_count = {};\n", functions.size());
+
+        std::string vec;
+        for (size_t ti = 0; ti < suite.tests.size(); ti++)
+        {
+            auto& tc = suite.tests[ti];
+            std::string status = testStatus[ti];
+            if (testFunction[ti] >= 0)
+            {
+                std::string body = fmt::format("T {} {}\n", tc.name, testFunction[ti]);
+                std::string annError;
+                for (auto& a : tc.annotations)
+                {
+                    std::string line, err;
+                    if (a.key == "REGISTER_IN" || a.key == "REGISTER_OUT")
+                    {
+                        if (RegisterLine(a.key == "REGISTER_IN" ? 'I' : 'O', a.value, line, err)) body += line + "\n";
+                        else if (annError.empty()) annError = a.key + " " + a.value + ": " + err;
+                    }
+                    else if (a.key == "MEMORY_IN" || a.key == "MEMORY_OUT")
+                    {
+                        size_t sp = a.value.find(' ');
+                        std::string addr = a.value.substr(0, sp);
+                        std::string bytes = sp == std::string::npos ? "" : a.value.substr(sp + 1);
+                        uint32_t address = uint32_t(strtoul(addr.c_str(), nullptr, 16));
+                        body += fmt::format("{} {:X} {}\n", a.key == "MEMORY_IN" ? 'M' : 'X', address, MemoryHex(bytes));
+                    }
+                }
+                if (!annError.empty())
+                {
+                    status = "ENC\tannotation " + Sanitize(annError);
+                    ++testsEncFailed;
+                }
+                else
+                {
+                    vec += body;
+                    ++testsRunnable;
+                    status = fmt::format("RUN\tf{}\t{}", testFunction[ti], Sanitize(fnProblems[testFunction[ti]]));
+                }
+            }
+            fmt::println(manifest, "{}\t{}\t{}\t{}", suite.name, tc.name, Mnemonics(suite, tc), status);
+        }
+
+        auto write = [&](const std::string& ext, const std::string& text)
+            {
+                auto p = outDir / "gen" / (suite.name + ext);
+                // leave an identical file alone so its object isn't rebuilt
+                std::ifstream old(p, std::ios::binary);
+                if (old)
+                {
+                    std::stringstream ss;
+                    ss << old.rdbuf();
+                    if (ss.str() == text) return;
+                }
+                old.close();
+                std::ofstream o(p, std::ios::binary);
+                o << text;
+            };
+        write(".cpp", cpp);
+        write(".vec", vec);
+        write(".map", map);
+        fmt::println(suitesList, "{}\t{}\t{}", suite.name, suite.tests.size(), functions.size());
+    }
+
+    fmt::println(encoderLog, "");
+    fmt::println(encoderLog, "Round-trip failures ({}):", roundTripFailures.size());
+    for (auto& r : roundTripFailures) fmt::println(encoderLog, "  {}", r);
+    fmt::println(encoderLog, "");
+    fmt::println(encoderLog, "Round trips via an alias spelling (distinct lines, {}):", aliasLines.size());
+    for (auto& r : aliasLines) fmt::println(encoderLog, "  {}", r);
+
+    FILE* stats = fopen((outDir / "encoder_stats.txt").string().c_str(), "w");
+    fmt::println(stats, "instruction_lines {}", linesTotal);
+    fmt::println(stats, "assembled {}", linesAssembled);
+    fmt::println(stats, "assembled_with_warning {}", linesWarned);
+    fmt::println(stats, "decoded {}", linesDecoded);
+    fmt::println(stats, "roundtrip_strict {}", linesStrict);
+    fmt::println(stats, "roundtrip_alias {}", linesLoose);
+    fmt::println(stats, "unique_lines {}", uniqueTotal.size());
+    fmt::println(stats, "unique_roundtrip {}", uniqueStrictOrLoose.size());
+    fmt::println(stats, "long_words {}", longsTotal);
+    fmt::println(stats, "tests {}", testsTotal);
+    fmt::println(stats, "tests_skipped {}", testsSkipped);
+    fmt::println(stats, "tests_encoder_failed {}", testsEncFailed);
+    fmt::println(stats, "tests_runnable {}", testsRunnable);
+    fmt::println(stats, "functions {}", functionsTotal);
+    fclose(stats);
+    fclose(manifest);
+    fclose(encoderLog);
+    fclose(problemsLog);
+    fclose(suitesList);
+
+    fmt::println("{} instruction lines, {} assembled ({} with warnings), {} decode, {} round-trip exactly, {} via alias",
+        linesTotal, linesAssembled, linesWarned, linesDecoded, linesStrict, linesLoose);
+    fmt::println("{} tests: {} skipped, {} encoder-failed, {} runnable, {} distinct functions",
+        testsTotal, testsSkipped, testsEncFailed, testsRunnable, functionsTotal);
+    return 0;
+}
diff --git a/ReXenonTests/run.py b/ReXenonTests/run.py
new file mode 100644
index 0000000..6f40b1c
--- /dev/null
+++ b/ReXenonTests/run.py
@@ -0,0 +1,470 @@
+"""ReXenon instruction test bench.
+
+Builds the test driver, assembles Xenia's PPC instruction tests and recompiles them with ReXenon's
+emitter, compiles the generated C++ with clang-cl, runs every test and writes results.txt.
+
+    py -I D:\\ReXenon\\ReXenonTests\\run.py [--filter instr_vadd] [--jobs 6] [--no-build]
+
+Outputs (next to this script): results.txt (summary and failures by instruction) and
+results_all.tsv (one line per test). Work files go to D:\\ReXenon\\build-tests\\rxt.
+"""
+import argparse
+import collections
+import concurrent.futures
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+BUILD = os.path.join(ROOT, "build-tests")
+WORK = os.path.join(BUILD, "rxt")
+GEN = os.path.join(WORK, "gen")
+OBJ = os.path.join(WORK, "obj")
+RESULTS = ""  # suffix for results.txt / results_all.tsv when run with --options or --cflag
+TESTS = r"D:\xenia-src\src\xenia\cpu\ppc\testing"
+VCENV = r"D:\fm2-port\tools\vcenv.cmd"
+DRIVER = os.path.join(BUILD, "ReXenonTests", "ReXenonTestDriver.exe")
+
+CXXFLAGS = ["/nologo", "/c", "/O2", "/DNDEBUG", "/std:c++20", "/MT", "-msse4.1", "-fno-strict-aliasing",
+            "-Wno-everything", "/I" + os.path.join(HERE, "runtime"), "/I" + os.path.join(ROOT, "XenonUtils"),
+            "/I" + os.path.join(ROOT, "thirdparty", "simde")]
+
+
+def log(msg):
+    print(msg, flush=True)
+
+
+def vc_environment():
+    out = subprocess.run(["cmd", "/c", VCENV, "set"], capture_output=True, text=True, errors="replace").stdout
+    env = {}
+    for line in out.splitlines():
+        if "=" in line and not line.startswith("="):
+            k, v = line.split("=", 1)
+            env[k] = v
+    if "INCLUDE" not in env:
+        sys.exit("vcenv.cmd didn't set up the compiler environment")
+    return env
+
+
+def run(cmd, env, **kw):
+    # Windows looks the program up on this process's PATH, not env's: resolve it first.
+    exe = shutil.which(cmd[0], path=env.get("PATH") or env.get("Path"))
+    cmd = [exe or cmd[0]] + list(cmd[1:])
+    return subprocess.run(cmd, env=env, capture_output=True, text=True, errors="replace", **kw)
+
+
+def build_driver(env):
+    log("configuring and building ReXenonTestDriver ...")
+    r = run(["cmake", "-S", ROOT, "-B", BUILD, "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release",
+             "-DCMAKE_C_COMPILER=clang-cl", "-DCMAKE_CXX_COMPILER=clang-cl", "-DREXENON_TESTS=ON"], env)
+    if r.returncode != 0:
+        sys.exit("cmake failed:\n" + r.stdout + r.stderr)
+    r = run(["ninja", "-C", BUILD, "ReXenonTestDriver"], env)
+    if r.returncode != 0:
+        sys.exit("building the driver failed:\n" + r.stdout[-6000:] + r.stderr[-2000:])
+
+
+def newer(target, *sources):
+    if not os.path.exists(target):
+        return False
+    t = os.path.getmtime(target)
+    return all(os.path.getmtime(s) <= t for s in sources)
+
+
+ERROR_RE = re.compile(r"^(.*?)\((\d+),\d+\): error: (.*)$")
+
+
+def compile_suite(name, env, harness_obj, runtime_deps):
+    """Compile and link one suite. Functions that don't compile are left out (RXT_SKIP_Fn) and
+    reported; returns (exe or None, {function: error}, whole-suite error or None)."""
+    cpp = os.path.join(GEN, name + ".cpp")
+    obj = os.path.join(OBJ, name + ".obj")
+    exe = os.path.join(OBJ, name + ".exe")
+    errfile = os.path.join(OBJ, name + ".errors")
+    if newer(exe, cpp, harness_obj, *runtime_deps) and os.path.exists(errfile):
+        errors = {}
+        with open(errfile) as f:
+            for line in f:
+                fn, _, msg = line.rstrip("\n").partition("\t")
+                errors[fn] = msg
+        return exe, errors, errors.get("*")
+
+    ranges = []
+    with open(os.path.join(GEN, name + ".map")) as f:
+        for line in f:
+            i, a, b = line.split()
+            ranges.append((int(i), int(a), int(b)))
+
+    skipped = {}
+    suite_error = None
+    for attempt in range(6):
+        defs = ["/DRXT_SKIP_F%d" % i for i in sorted(skipped)]
+        r = run(["clang-cl"] + CXXFLAGS + defs + [cpp, "/Fo" + obj], env)
+        if r.returncode == 0:
+            break
+        new = {}
+        unmapped = None
+        for line in (r.stdout + r.stderr).splitlines():
+            m = ERROR_RE.match(line.strip())
+            if not m:
+                continue
+            if os.path.normcase(os.path.abspath(m.group(1))) != os.path.normcase(cpp):
+                unmapped = unmapped or line.strip()
+                continue
+            ln = int(m.group(2))
+            for i, a, b in ranges:
+                if a <= ln <= b:
+                    if i not in skipped and i not in new:
+                        new[i] = m.group(3)
+                    break
+            else:
+                unmapped = unmapped or line.strip()
+        if not new:
+            suite_error = unmapped or (r.stdout + r.stderr).strip().splitlines()[-1:] or ["compile failed"]
+            suite_error = suite_error if isinstance(suite_error, str) else suite_error[0]
+            break
+        skipped.update(new)
+    else:
+        suite_error = "too many compile rounds"
+
+    errors = {"f%d" % i: msg for i, msg in skipped.items()}
+    if suite_error is None:
+        r = run(["clang-cl", "/nologo", "-fuse-ld=lld", obj, harness_obj, "/Fe" + exe, "/link", "/INCREMENTAL:NO"], env)
+        if r.returncode != 0:
+            suite_error = "link failed: " + (r.stdout + r.stderr).strip()[-500:]
+    if suite_error is not None:
+        errors["*"] = suite_error
+        if os.path.exists(exe):
+            os.remove(exe)
+    with open(errfile, "w") as f:
+        for fn, msg in errors.items():
+            f.write("%s\t%s\n" % (fn, msg.replace("\t", " ")))
+    return (None if suite_error else exe), errors, suite_error
+
+
+LINE_RE = re.compile(r"^(PASS|FAIL|UNIMPL|CRASH|NOFN|HANG) (\d+) (\S+) ?(.*)$")
+
+
+def run_suite(name, exe, total):
+    """Run a suite's exe, restarting after a test that hangs or takes the process down."""
+    vec = os.path.join(GEN, name + ".vec")
+    results = {}
+    start = 0
+    while start < total:
+        try:
+            p = subprocess.run([exe, vec, str(start)], capture_output=True, text=True, errors="replace", timeout=600)
+            out, code = p.stdout, p.returncode
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+            code = -1
+        last = start - 1
+        for line in out.splitlines():
+            m = LINE_RE.match(line)
+            if not m:
+                continue
+            idx = int(m.group(2))
+            results[idx] = (m.group(1), m.group(3), m.group(4))
+            last = max(last, idx)
+        if code == 0 and last >= total - 1:
+            break
+        if code == 0:
+            break
+        # the test after the last reported one took the process down (or hung, reported as HANG)
+        nxt = last + 1
+        if nxt < total and nxt not in results:
+            results[nxt] = ("CRASH", None, "process exited with 0x%08X" % (code & 0xFFFFFFFF))
+        start = max(nxt + 1, start + 1)
+    return results
+
+
+def group_of(suite):
+    n = suite[len("instr_"):]
+    if n.startswith("_gen_"):
+        return n[len("_gen_"):]
+    return n
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--filter", default="", help="only suites whose file name contains this")
+    ap.add_argument("--jobs", type=int, default=6)
+    ap.add_argument("--no-build", action="store_true", help="don't rebuild the driver")
+    ap.add_argument("--options", default="", help="recompiler options for this run, comma-separated "
+                    "(exact_estimates, fused_madd); work files and results get their own names")
+    ap.add_argument("--cflag", action="append", default=[], help="extra compiler flag, e.g. -mfma (repeatable)")
+    args = ap.parse_args()
+
+    global WORK, GEN, OBJ, CXXFLAGS, RESULTS
+    if args.options or args.cflag:
+        tag = "-".join([o for o in args.options.split(",") if o] + [c.lstrip("-/") for c in args.cflag])
+        WORK = WORK + "-" + tag
+        GEN = os.path.join(WORK, "gen")
+        OBJ = os.path.join(WORK, "obj")
+        RESULTS = "-" + tag
+    CXXFLAGS = CXXFLAGS + args.cflag
+
+    t0 = time.time()
+    env = vc_environment()
+    env["REXENON_TEST_OPTIONS"] = args.options
+    os.makedirs(GEN, exist_ok=True)
+    os.makedirs(OBJ, exist_ok=True)
+    if not args.no_build:
+        build_driver(env)
+
+    log("assembling and recompiling the tests ...")
+    for f in ("manifest.tsv", "suites.txt"):
+        p = os.path.join(WORK, f)
+        if os.path.exists(p):
+            os.remove(p)
+    r = run([DRIVER, TESTS, WORK] + ([args.filter] if args.filter else []), env)
+    with open(os.path.join(WORK, "driver.log"), "w") as f:
+        f.write(r.stdout + r.stderr)
+    if r.returncode != 0:
+        sys.exit("driver failed:\n" + r.stdout[-3000:] + r.stderr[-3000:])
+    log(r.stdout.strip().splitlines()[-2] if r.stdout.strip() else "")
+    log(r.stdout.strip().splitlines()[-1] if r.stdout.strip() else "")
+
+    # compile the harness once
+    harness_cpp = os.path.join(HERE, "runtime", "harness.cpp")
+    runtime_deps = [os.path.join(HERE, "runtime", "rxt_runtime.h"), os.path.join(ROOT, "XenonUtils", "ppc_context.h")]
+    harness_obj = os.path.join(OBJ, "harness.obj")
+    if not newer(harness_obj, harness_cpp, *runtime_deps):
+        r = run(["clang-cl"] + CXXFLAGS + [harness_cpp, "/Fo" + harness_obj], env)
+        if r.returncode != 0:
+            sys.exit("harness doesn't compile:\n" + r.stdout + r.stderr)
+
+    suites = []
+    with open(os.path.join(WORK, "suites.txt")) as f:
+        for line in f:
+            name, ntests, nfns = line.split("\t")
+            suites.append(name)
+
+    manifest = []  # (suite, test, mnemonics, status, detail)
+    vec_index = collections.defaultdict(list)  # suite -> [test name in .vec order]
+    with open(os.path.join(WORK, "manifest.tsv")) as f:
+        for line in f:
+            parts = line.rstrip("\n").split("\t")
+            suite, test, mnems, status = parts[0], parts[1], parts[2], parts[3]
+            rest = parts[4:]
+            manifest.append((suite, test, mnems, status, rest))
+            if status == "RUN":
+                vec_index[suite].append(test)
+
+    log("compiling %d suites (%d jobs) ..." % (len(suites), args.jobs))
+    compiled = {}
+    with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
+        futs = {pool.submit(compile_suite, s, env, harness_obj, runtime_deps): s for s in suites}
+        done = 0
+        for fut in concurrent.futures.as_completed(futs):
+            s = futs[fut]
+            compiled[s] = fut.result()
+            done += 1
+            if done % 50 == 0:
+                log("  %d/%d" % (done, len(suites)))
+
+    log("running ...")
+    ran = {}
+    with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
+        futs = {}
+        for s in suites:
+            exe = compiled[s][0]
+            if exe and vec_index[s]:
+                futs[pool.submit(run_suite, s, exe, len(vec_index[s]))] = s
+        for fut in concurrent.futures.as_completed(futs):
+            ran[futs[fut]] = fut.result()
+
+    # ---------------------------------------------------------------- results
+    rows = []  # suite, test, status, detail, mnemonics
+    for suite, test, mnems, status, rest in manifest:
+        if status == "SKIP":
+            rows.append((suite, test, "SKIPPED", "", mnems))
+            continue
+        if status == "ENC":
+            rows.append((suite, test, "ENCODER_FAILED", rest[0] if rest else "", mnems))
+            continue
+        fn = rest[0]
+        exe, errors, suite_error = compiled.get(suite, (None, {}, "not compiled"))
+        if suite_error:
+            rows.append((suite, test, "COMPILE_FAILED", suite_error, mnems))
+            continue
+        if fn in errors:
+            rows.append((suite, test, "COMPILE_FAILED", "%s: %s" % (fn, errors[fn]), mnems))
+            continue
+        rows.append([suite, test, "PENDING", fn, mnems])
+
+    # match run results by index within the suite's .vec
+    index_of = {s: {t: i for i, t in enumerate(names)} for s, names in vec_index.items()}
+    final = []
+    for row in rows:
+        if row[2] != "PENDING":
+            final.append(tuple(row))
+            continue
+        suite, test = row[0], row[1]
+        i = index_of[suite][test]
+        res = ran.get(suite, {}).get(i)
+        if res is None:
+            final.append((suite, test, "NOT_RUN", "", row[4]))
+            continue
+        kind, _, detail = res
+        status = {"PASS": "PASS", "FAIL": "FAIL", "UNIMPL": "UNIMPLEMENTED", "CRASH": "CRASH",
+                  "HANG": "HANG", "NOFN": "COMPILE_FAILED"}[kind]
+        final.append((suite, test, status, detail, row[4]))
+
+    counts = collections.Counter(r[2] for r in final)
+    stats = {}
+    with open(os.path.join(WORK, "encoder_stats.txt")) as f:
+        for line in f:
+            k, v = line.split()
+            stats[k] = int(v)
+
+    with open(os.path.join(HERE, "results_all%s.tsv" % RESULTS), "w") as f:
+        f.write("suite\ttest\tstatus\tinstructions\tdetail\n")
+        for suite, test, status, detail, mnems in final:
+            f.write("%s\t%s\t%s\t%s\t%s\n" % (suite, test, status, mnems, detail))
+
+    write_results(final, counts, stats, compiled, time.time() - t0)
+    log("\n\n".join(open(os.path.join(HERE, "results%s.txt" % RESULTS)).read().split("\n\n")[:3]))
+
+
+def failure_key(status, detail):
+    """A short signature to group similar failures: the registers that mismatched."""
+    if status == "FAIL":
+        regs = [m.split(" ")[0] for m in detail.split(" ; ")]
+        return "mismatch in " + ",".join(sorted(set(re.sub(r"\d+$", "N", r) if r.startswith("mem") else r for r in regs)))
+    if status == "UNIMPLEMENTED":
+        return re.sub(r" at 0x[0-9A-F]+", "", re.sub(r"0x[0-9A-F]+ -> 0x[0-9A-F]+", "", detail))
+    if status == "CRASH":
+        return re.sub(r"address 0x[0-9A-F]+", "", detail)
+    return detail[:120]
+
+
+def fail_tags(final):
+    """For each FAIL test: cr-only, NaN, denormal or ordinary, from the values in its .vec."""
+    def nan32(w): return (w >> 23) & 0xFF == 0xFF and w & 0x7FFFFF
+    def den32(w): return (w >> 23) & 0xFF == 0 and w & 0x7FFFFF
+    def nan64(w): return (w >> 52) & 0x7FF == 0x7FF and w & ((1 << 52) - 1)
+    def den64(w): return (w >> 52) & 0x7FF == 0 and w & ((1 << 52) - 1)
+    wanted = collections.defaultdict(set)
+    for r in final:
+        if r[2] == "FAIL":
+            wanted[r[0]].add(r[1])
+    tags = {}
+    for suite, names in wanted.items():
+        values = {}
+        cur = None
+        with open(os.path.join(GEN, suite + ".vec")) as f:
+            for line in f:
+                p = line.split()
+                if p[0] == "T":
+                    cur = p[1] if p[1] in names else None
+                    if cur:
+                        values[cur] = []
+                elif cur and p[0] in ("I", "O"):
+                    if p[1].startswith("v"):
+                        values[cur] += [("s", int(x, 16)) for x in p[2:6]]
+                    elif p[1].startswith("f"):
+                        values[cur].append(("d", int(p[-1], 16)))
+        for r in final:
+            if r[0] != suite or r[2] != "FAIL":
+                continue
+            if all(m.startswith("cr ") for m in r[3].split(" ; ")):
+                tags[(r[0], r[1])] = "cr-only"
+                continue
+            vals = values.get(r[1], [])
+            if any((nan32(w) if k == "s" else nan64(w)) for k, w in vals):
+                tags[(r[0], r[1])] = "NaN"
+            elif any((den32(w) if k == "s" else den64(w)) for k, w in vals):
+                tags[(r[0], r[1])] = "denormal"
+            else:
+                tags[(r[0], r[1])] = "ordinary"
+    return tags
+
+
+def write_results(final, counts, stats, compiled, elapsed):
+    order = ["PASS", "FAIL", "UNIMPLEMENTED", "CRASH", "HANG", "COMPILE_FAILED", "ENCODER_FAILED", "SKIPPED", "NOT_RUN"]
+    total = len(final)
+    gen = [r for r in final if "__gen_" in r[0]]
+    hand = [r for r in final if "__gen_" not in r[0]]
+
+    out = []
+    out.append("ReXenon instruction tests (Xenia's src/xenia/cpu/ppc/testing, instr_*.s)")
+    out.append("Generated %s in %.0f s. Rerun: py -I %s" % (time.strftime("%Y-%m-%d %H:%M"), elapsed, os.path.join(HERE, "run.py")))
+    out.append("")
+    out.append("%-16s %8s %10s %10s" % ("status", "all", "hand", "_GEN"))
+    for k in order:
+        a = counts.get(k, 0)
+        if a or k in ("PASS", "FAIL", "UNIMPLEMENTED", "COMPILE_FAILED", "ENCODER_FAILED", "SKIPPED"):
+            out.append("%-16s %8d %10d %10d" % (k.lower().replace("_", "-"), a,
+                                                sum(1 for r in hand if r[2] == k), sum(1 for r in gen if r[2] == k)))
+    out.append("%-16s %8d %10d %10d" % ("total", total, len(hand), len(gen)))
+    out.append("")
+    out.append("Encoder: %d instruction lines (%d distinct); %d assembled (%d with a range warning);"
+               % (stats["instruction_lines"], stats["unique_lines"], stats["assembled"], stats["assembled_with_warning"]))
+    rt = stats["roundtrip_strict"] + stats["roundtrip_alias"]
+    out.append("  round-trip through ppc::Disassemble: %d/%d (%.2f%%): %d same mnemonic and operands, %d via an alias"
+               " (disassembles to another spelling that assembles back to the same word); %d/%d distinct lines."
+               % (rt, stats["instruction_lines"], 100.0 * rt / max(1, stats["instruction_lines"]), stats["roundtrip_strict"],
+                  stats["roundtrip_alias"], stats["unique_roundtrip"], stats["unique_lines"]))
+    out.append("  plus %d raw .long words. Details: %s" % (stats["long_words"], os.path.join(WORK, "encoder.txt")))
+    out.append("  %d tests share %d distinct recompiled functions (identical code is recompiled once)." % (stats["tests_runnable"], stats["functions"]))
+    out.append("")
+
+    # per instruction group
+    groups = collections.defaultdict(list)
+    for r in final:
+        groups[group_of(r[0])].append(r)
+    bad = [(g, rs) for g, rs in groups.items() if any(r[2] not in ("PASS", "SKIPPED") for r in rs)]
+    bad.sort(key=lambda x: (-sum(1 for r in x[1] if r[2] not in ("PASS", "SKIPPED")), x[0]))
+
+    tags = fail_tags(final)
+    out.append("Instructions with failures (%d of %d instructions; failing/total tests)." % (len(bad), len(groups)))
+    out.append("For value mismatches, [..] says what the test data involves: cr-only (only CR differs),")
+    out.append("NaN or denormal (a NaN/denormal among the test's register values), ordinary (neither).")
+    for g, rs in bad:
+        nbad = sum(1 for r in rs if r[2] not in ("PASS", "SKIPPED"))
+        kinds = collections.Counter(r[2] for r in rs if r[2] not in ("PASS", "SKIPPED"))
+        tagc = collections.Counter(tags[(r[0], r[1])] for r in rs if r[2] == "FAIL")
+        tagtext = " [%s]" % ", ".join("%s %d" % (k, v) for k, v in tagc.most_common()) if tagc else ""
+        out.append("  %-14s %6d/%-6d %s%s" % (g, nbad, len(rs), ", ".join("%s %d" % (k.lower(), v) for k, v in kinds.most_common()), tagtext))
+    out.append("")
+
+    # dot-form instructions the emitter writes no CR update for (the recompiler's own warning)
+    rc = collections.Counter()
+    try:
+        for line in open(os.path.join(WORK, "driver.log")):
+            m = re.match(r"^(\S+) at [0-9A-F]+ has RC bit enabled but no comparison was generated", line)
+            if m:
+                rc[m.group(1)] += 1
+    except OSError:
+        pass
+    if rc:
+        out.append("Recompiler warnings 'RC bit enabled but no comparison was generated' (no cr0/cr6 write; the FP")
+        out.append("forms set cr1, which the check doesn't look for), by mnemonic: " + ", ".join(sorted(rc)))
+        out.append("")
+
+    out.append("Failures by instruction (each group: signature, count, examples; every test in results_all.tsv):")
+    for g, rs in bad:
+        failing = [r for r in rs if r[2] not in ("PASS", "SKIPPED")]
+        out.append("")
+        out.append("== %s: %d of %d failing" % (g, len(failing), len(rs)))
+        sigs = collections.defaultdict(list)
+        for r in failing:
+            sigs[(r[2], failure_key(r[2], r[3]))].append(r)
+        for (status, key), items in sorted(sigs.items(), key=lambda x: -len(x[1])):
+            out.append("  [%s] %s: %d" % (status.lower(), key, len(items)))
+            limit = 3 if len(items) > 3 else len(items)
+            for r in items[:limit]:
+                out.append("      %s:%s  %s" % (r[0], r[1], r[3][:400]))
+            if len(items) > limit:
+                out.append("      ... %d more" % (len(items) - limit))
+
+    with open(os.path.join(HERE, "results%s.txt" % RESULTS), "w") as f:
+        f.write("\n".join(out) + "\n")
+
+
+if __name__ == "__main__":
+    main()
