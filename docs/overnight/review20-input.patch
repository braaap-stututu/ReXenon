+// Filler for the indirect-call table's empty slots. A port's loader writes it into every slot no
+// recompiled function maps to (before installing its hooks), so a call through a bad pointer
+// reaches PPC_INDIRECT_MISS instead of jumping to null, at no cost per call. bctrl leaves the
+// target in ctr, so ctr is passed; for blrl (target in lr, which the call has overwritten) it is
+// only a hint.
+inline PPC_FUNC(PPCUnmappedFunction)
+{
+    (void)base;
+#ifndef PPC_CONFIG_CTR_AS_LOCAL
+    PPC_INDIRECT_MISS(uint32_t(ctx.ctr.u32));
+#else
+    (void)ctx;
+    PPC_INDIRECT_MISS(uint32_t(0));
+#endif
+}
+
 #endif
